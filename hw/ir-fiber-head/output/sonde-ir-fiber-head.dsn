      (pin Rect[T]Pad_600x600_um 2 0 1270)
    )
    (image "Capacitor_SMD:C_0603_1608Metric"
      (pin Rect[T]Pad_600x600_um 1 0 0)
      (pin Rect[T]Pad_600x600_um 2 0 1270)
    )
    (padstack Via[0-1]_600:300_um
      (shape (circle F.Cu 600 0 0))
      (shape (circle B.Cu 600 0 0))
      (attach off)
    )
    (padstack Rect[T]Pad_600x600_um
      (shape (rect F.Cu -300 -300 300 300))
      (attach off)
    )
  )
  (network
    (net 3V3
      (pins U1-1 U1-5 U1-17 J1-1 R_NRST-2 C_VDD1-1 C_VDD2-1 C_VDDA-1 C_BULK-1 R_TX0-1 R_TX1-1 R_TX2-1 R_TX3-1 R_TX4-1 R_TX5-1 R_TX6-1 R_TX7-1 R_RX0-1 R_RX1-1 R_RX2-1 R_RX3-1 R_RX4-1 R_RX5-1 R_RX6-1 R_RX7-1)
    )
    (net BOOT0
      (pins U1-31 TP2-1 R_BOOT-1)
    )
    (net GND
      (pins U1-16 J1-2 R_BOOT-2 C_VDD1-2 C_VDD2-2 C_VDDA-2 C_BULK-2 D_RX0-1 D_RX1-1 D_RX2-1 D_RX3-1 D_RX4-1 D_RX5-1 D_RX6-1 D_RX7-1)
    )
    (net LED0_A
      (pins R_TX0-2 D_TX0-1)
    )
    (net LED1_A
      (pins R_TX1-2 D_TX1-1)
    )
    (net LED2_A
      (pins R_TX2-2 D_TX2-1)
    )
    (net LED3_A
      (pins R_TX3-2 D_TX3-1)
    )
    (net LED4_A
      (pins R_TX4-2 D_TX4-1)
    )
    (net LED5_A
      (pins R_TX5-2 D_TX5-1)
    )
    (net LED6_A
      (pins R_TX6-2 D_TX6-1)
    )
    (net LED7_A
      (pins R_TX7-2 D_TX7-1)
    )
    (net NRST
      (pins U1-4 TP1-1 R_NRST-1)
    )
    (net RX0
      (pins U1-6 R_RX0-2 D_RX0-2)
    )
    (net RX1
      (pins U1-7 R_RX1-2 D_RX1-2)
    )
    (net RX2
      (pins U1-8 R_RX2-2 D_RX2-2)
    )
    (net RX3
      (pins U1-9 R_RX3-2 D_RX3-2)
    )
    (net RX4
      (pins U1-10 R_RX4-2 D_RX4-2)
    )
    (net RX5
      (pins U1-11 R_RX5-2 D_RX5-2)
    )
    (net RX6
      (pins U1-12 R_RX6-2 D_RX6-2)
    )
    (net RX7
      (pins U1-13 R_RX7-2 D_RX7-2)
    )
    (net SCL
      (pins U1-29 J1-3)
    )
    (net SDA
      (pins U1-30 J1-4)
    )
    (net TX0
      (pins U1-18 D_TX0-2)
    )
    (net TX1
      (pins U1-19 D_TX1-2)
    )
    (net TX2
      (pins U1-20 D_TX2-2)
    )
    (net TX3
      (pins U1-21 D_TX3-2)
    )
    (net TX4
      (pins U1-22 D_TX4-2)
    )
    (net TX5
      (pins U1-25 D_TX5-2)
    )
    (net TX6
      (pins U1-26 D_TX6-2)
    )
    (net TX7
      (pins U1-27 D_TX7-2)
    )
    (class Power 3V3 GND
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 5000) (clearance 200))
    )
    (class Default
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 250) (clearance 200))
    )
  )
  (wiring)
)
