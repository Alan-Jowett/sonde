    )
    (image "Sonde_Opto:LED_D3.0mm_P2.54mm_Fiber1.00mm_UpsideDown"
      (pin Rect[T]Pad_600x600_um 1 0 0)
      (pin Rect[T]Pad_600x600_um 2 0 1270)
    )
    (image "Sonde_Opto:Photodiode_D3.0mm_P2.54mm_Fiber1.00mm_UpsideDown"
      (pin Rect[T]Pad_600x600_um 1 0 0)
      (pin Rect[T]Pad_600x600_um 2 0 1270)
    )
    (image "Resistor_SMD:R_0603_1608Metric"
