(pcb "sonde-ir-fiber-head.dsn"
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "sonde-kicad")
    (host_version "0.8.0")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary
      (path signal 0 1260000 -1150000 1710000 -1150000 1710000 -950000 1260000 -950000 1260000 -1150000)
    )
    (via "Via[0-1]_600:300_um")
    (rule (width 2500) (clearance 200))
  )
  (placement
    (component "Capacitor_SMD:C_0603_1608Metric"
      (place C_VDD1 1330000 -1096000 front 0)
      (place C_VDD2 1600000 -1078000 front 0)
      (place C_VDDA 1370000 -1096000 front 0)
      (place C_BULK 1600000 -1096000 front 0)
    )
    (component "Package_QFP:LQFP-32_7x7mm_P0.8mm"
      (place U1 1485000 -1050000 front 0)
    )
    (component "Resistor_SMD:R_0603_1608Metric"
      (place R_TX0 1330000 -1006000 front 0)
      (place R_TX1 1330000 -1024000 front 0)
      (place R_TX2 1330000 -1042000 front 0)
      (place R_TX3 1330000 -1060000 front 0)
      (place R_TX4 1600000 -1006000 front 0)
      (place R_TX5 1600000 -1024000 front 0)
      (place R_TX6 1600000 -1042000 front 0)
      (place R_TX7 1600000 -1060000 front 0)
      (place R_RX0 1370000 -1006000 front 0)
      (place R_RX1 1370000 -1024000 front 0)
      (place R_RX2 1370000 -1042000 front 0)
      (place R_RX3 1370000 -1060000 front 0)
      (place R_RX4 1640000 -1006000 front 0)
      (place R_RX5 1640000 -1024000 front 0)
      (place R_RX6 1640000 -1042000 front 0)
      (place R_RX7 1640000 -1060000 front 0)
      (place R_BOOT 1330000 -1078000 front 0)
      (place R_NRST 1370000 -1078000 front 0)
    )
    (component "Sonde_Connector:WirePad_1x04_P2.54mm_D1.0mm"
      (place J1 1695000 -1088100 front 270)
    )
    (component "Sonde_Opto:LED_D3.0mm_P2.54mm_Fiber1.00mm_UpsideDown"
      (place D_TX0 1294200 -972500 front 0)
      (place D_TX1 1345000 -972500 front 0)
      (place D_TX2 1395800 -972500 front 0)
      (place D_TX3 1446600 -972500 front 0)
      (place D_TX4 1497400 -972500 front 0)
      (place D_TX5 1548200 -972500 front 0)
      (place D_TX6 1599000 -972500 front 0)
      (place D_TX7 1649800 -972500 front 0)
    )
    (component "Sonde_Opto:Photodiode_D3.0mm_P2.54mm_Fiber1.00mm_UpsideDown"
      (place D_RX0 1294200 -1127500 front 0)
      (place D_RX1 1345000 -1127500 front 0)
      (place D_RX2 1395800 -1127500 front 0)
      (place D_RX3 1446600 -1127500 front 0)
      (place D_RX4 1497400 -1127500 front 0)
      (place D_RX5 1548200 -1127500 front 0)
      (place D_RX6 1599000 -1127500 front 0)
      (place D_RX7 1649800 -1127500 front 0)
    )
    (component "TestPoint:TestPoint_THTPad_D1.5mm_Drill0.7mm"
      (place TP1 1277500 -1037500 front 0)
      (place TP2 1277500 -1062500 front 0)
    )
  )
  (library
    (image "Package_QFP:LQFP-32_7x7mm_P0.8mm"
      (pin Rect[T]Pad_600x600_um 1 0 0)
      (pin Rect[T]Pad_600x600_um 2 0 1270)
      (pin Rect[T]Pad_600x600_um 3 0 2540)
      (pin Rect[T]Pad_600x600_um 4 0 3810)
      (pin Rect[T]Pad_600x600_um 5 0 5080)
      (pin Rect[T]Pad_600x600_um 6 0 6350)
      (pin Rect[T]Pad_600x600_um 7 0 7620)
      (pin Rect[T]Pad_600x600_um 8 0 8890)
      (pin Rect[T]Pad_600x600_um 9 0 10160)
      (pin Rect[T]Pad_600x600_um 10 0 11430)
      (pin Rect[T]Pad_600x600_um 11 0 12700)
      (pin Rect[T]Pad_600x600_um 12 0 13970)
      (pin Rect[T]Pad_600x600_um 13 0 15240)
      (pin Rect[T]Pad_600x600_um 14 0 16510)
      (pin Rect[T]Pad_600x600_um 15 0 17780)
      (pin Rect[T]Pad_600x600_um 16 0 19050)
      (pin Rect[T]Pad_600x600_um 17 0 20320)
      (pin Rect[T]Pad_600x600_um 18 0 21590)
      (pin Rect[T]Pad_600x600_um 19 0 22860)
      (pin Rect[T]Pad_600x600_um 20 0 24130)
      (pin Rect[T]Pad_600x600_um 21 0 25400)
      (pin Rect[T]Pad_600x600_um 22 0 26670)
      (pin Rect[T]Pad_600x600_um 23 0 27940)
      (pin Rect[T]Pad_600x600_um 24 0 29210)
      (pin Rect[T]Pad_600x600_um 25 0 30480)
      (pin Rect[T]Pad_600x600_um 26 0 31750)
      (pin Rect[T]Pad_600x600_um 27 0 33020)
      (pin Rect[T]Pad_600x600_um 28 0 34290)
      (pin Rect[T]Pad_600x600_um 29 0 35560)
      (pin Rect[T]Pad_600x600_um 30 0 36830)
      (pin Rect[T]Pad_600x600_um 31 0 38100)
      (pin Rect[T]Pad_600x600_um 32 0 39370)
    )
    (image "Sonde_Connector:WirePad_1x04_P2.54mm_D1.0mm"
      (pin Rect[T]Pad_600x600_um 1 0 0)
      (pin Rect[T]Pad_600x600_um 2 0 1270)
      (pin Rect[T]Pad_600x600_um 3 0 2540)
      (pin Rect[T]Pad_600x600_um 4 0 3810)
    )
    (image "TestPoint:TestPoint_THTPad_D1.5mm_Drill0.7mm"
