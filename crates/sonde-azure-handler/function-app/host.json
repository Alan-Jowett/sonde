{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "serviceBus": {
      "messageHandlerOptions": {
        "autoComplete": true,
        "maxConcurrentCalls": 16
      }
    }
  },
  "customHandler": {
    "description": {
      "defaultExecutablePath": "sonde-azure-handler"
    },
    "enableForwardingHttpRequest": true
  }
}
